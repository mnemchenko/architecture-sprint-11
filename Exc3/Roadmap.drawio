        </mxCell>
        <mxCell id="m-PEVpsJPltwY-xn-PRA-150" value="&lt;b&gt;&amp;nbsp;Разгрузка Camel и перенос сложной логики&lt;/b&gt;&lt;br&gt;Инфраструктурная команда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
