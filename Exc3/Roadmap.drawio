        <mxCell id="m-PEVpsJPltwY-xn-PRA-149" value="&lt;b&gt;Kafka как транспорт для Camel &lt;/b&gt;&lt;br&gt;Инфраструктурная команда" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
